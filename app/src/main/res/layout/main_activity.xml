<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:binding="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="activity"
            type="com.example.wanandroidkotlin.MainActivity" />
    </data>
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:openDrawer="start"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/tool_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_head_view_height"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/color_ff227bfa"
                app:navigationIcon="@drawable/ic_menu">
                <ImageView
                    android:id="@+id/add_article"
                    android:layout_width="@dimen/dimen_px_dp_40"
                    android:layout_height="@dimen/dimen_px_dp_40"
                    android:src="@drawable/add"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/margin_end"/>
                <ImageView
                    android:id="@+id/iv_search"
                    android:layout_width="@dimen/dimen_px_dp_30"
                    android:layout_height="@dimen/dimen_px_dp_30"
                    android:src="@drawable/ic_search"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/dimen_px_dp_10"/>
            </androidx.appcompat.widget.Toolbar>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
               android:layout_marginTop="@dimen/top_head_view_height">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/bottom_navi"/>
                <com.google.android.material.bottomnavigation.BottomNavigationView
                    android:id="@+id/bottom_navi"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/navigation_bottom_height"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:menu="@menu/main_bottom_menu"
                    android:background="@color/white"
                    app:itemIconTint="@drawable/selector_bottom_navigation"
                    app:itemTextColor="@drawable/selector_bottom_navigation"
                    android:orientation="horizontal"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/left_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/drawer_child_layout"
            android:layout_marginEnd="@dimen/dimen_px_dp_90"
            binding:activity="@{activity}"
            android:layout_gravity="start"/>
    </androidx.drawerlayout.widget.DrawerLayout>
</layout>