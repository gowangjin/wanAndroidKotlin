<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="WebActivity"
            type="com.example.moudle_web.ui.WebActivity" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/web_view_head"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_px_dp_50"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dimen_px_dp_24"
                android:layout_height="@dimen/dimen_px_dp_24"
                android:src="@drawable/ic_black_back"
                android:scaleType="fitXY"
                android:layout_marginStart="@dimen/dimen_px_dp_20"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:onClick="@{WebActivity::onClick}"/>
            <ImageView
                android:id="@+id/iv_android_icon"
                android:layout_width="@dimen/dimen_px_dp_30"
                android:layout_height="@dimen/dimen_px_dp_30"
                android:src="@mipmap/ic_android"
                android:scaleType="fitXY"
                android:layout_marginStart="@dimen/dimen_px_dp_10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_back"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dimen_px_sp_16"
                android:textColor="@color/color_ff3291f8"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/dimen_px_dp_10"
                app:layout_constraintStart_toEndOf="@id/iv_android_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="@string/play_android"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <WebView
            android:id="@+id/web_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/web_view_head"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>